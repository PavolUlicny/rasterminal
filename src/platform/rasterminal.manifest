<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- File paths reach the CRT, vendored loaders and Assimp as narrow strings, so the process code
     page must be UTF-8 for non-ASCII paths to open. Windows 10 1903 and later honor this setting;
     older versions keep the ANSI code page. Texture names inside model files are also read as
     UTF-8, so names that older tools stored in the ANSI code page no longer open. That trade is
     accepted because current exporters write UTF-8 and glTF requires it.

     longPathAware lifts the MAX_PATH limit only where the LongPathsEnabled machine policy is also
     set. A \\?\ prefix would work without the policy, but the loaders derive sidecar paths with
     "/" and "..", which Windows does not normalize under that prefix. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
